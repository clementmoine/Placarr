{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:check)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec tsc --noEmit:*)",
      "Bash(pnpm providers:audit:mapping)",
      "Bash(pnpm db:backups)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(pnpm prisma migrate reset:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(pnpm prisma db push --force-reset:*)",
      "Bash(FORCE=1 pnpm db:restore:*)",
      "Bash(rm -rf data:*)",
      "Bash(rm -rf ./data:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./certificates/**)"
    ]
  }
}
