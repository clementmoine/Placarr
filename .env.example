# Placarr — copy to `.env` and fill in what you need.
# Only the "Required" block is mandatory; everything else has a working default.
# Values shown after `default:` are what the code uses when the variable is unset.

# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. `compose.yml` provides one for the bundled DB.
DATABASE_URL="postgresql://placarr:placarr@localhost:5432/placarr"

# Signing secret for NextAuth sessions. The app refuses to boot without it.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Seed accounts
#
# `compose.yml` requires the two passwords and refuses to start without them —
# the container runs `prisma db seed` at boot, so these ARE the accounts of a
# Docker install. On the host workflow the seed defaults to `admin` /
# `guest-password`, which is fine locally and never fine when exposed.
# ─────────────────────────────────────────────────────────────────────────────

ADMIN_PASSWORD=""
GUEST_PASSWORD=""
# ADMIN_EMAIL=admin@placarr.com          # default: admin@placarr.com
# ADMIN_NAME=Admin                       # default: Admin
# GUEST_EMAIL=guest@placarr.com          # default: guest@placarr.com
# GUEST_NAME=Guest                       # default: Guest

# Registration is closed once the first account exists. The very first account
# created through /auth/register becomes the admin, so a fresh install without
# a seed can still bootstrap itself. Set this to open it back up.
# ALLOW_REGISTRATION=0                   # default: closed after the first user

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting
#
# In-process counters (no Redis): they reset on restart and only protect a
# single instance. Login is throttled per account (10 / 15 min) and per address
# (30 / 15 min), registration per address (5 / h), uploads per account
# (120 / h). Behind a reverse proxy, make sure it *overwrites*
# `X-Forwarded-For` — otherwise the address buckets are client-controlled.
# Not configurable by env today; the limits live next to their route.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Scraping — FlareSolverr
#
# Optional. Without it, Cloudflare-protected retailers are simply skipped.
# FlareSolverr is a single browser behind a serial queue, so both knobs below
# exist to stop one slow challenge from holding a worker slot.
# ─────────────────────────────────────────────────────────────────────────────

# FLARESOLVERR_URL=http://localhost:8191
# FLARESOLVERR_MAX_TIMEOUT_MS=30000      # default: 30000 — solve budget per challenge
# FLARESOLVERR_MAX_QUEUE_WAIT_MS=45000   # default: 45000 — give up rather than queue longer

# ─────────────────────────────────────────────────────────────────────────────
# Provider credentials
#
# Every one is optional: a provider without its key is reported as `blocked` by
# `pnpm providers:health` and skipped at runtime. All of these are free tiers.
# ─────────────────────────────────────────────────────────────────────────────

# BGG_API_TOKEN=                         # BoardGameGeek
# GOOGLE_BOOKS_API_KEY=
# OMDB_API_KEY=
# RAWG_API_KEY=
# SCANDEX_ACCESS_TOKEN=
# THEGAMESDB_API_KEY=
# TMDB_API_KEY=
# STEAMGRIDDB_API_KEY=                   # legacy alias STEAM_GRID_DB_API_KEY still read

# OAuth-style pairs
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# DISCOGS_CONSUMER_KEY=
# DISCOGS_CONSUMER_SECRET=
# DISCOGS_TOKEN=
# EBAY_CLIENT_ID=                        # needs Browse + commerce.catalog.readonly scopes
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_FR            # default: EBAY_FR

# ScreenScraper: DEV credentials identify the app, USER credentials raise the
# per-user quota. Both pairs are optional but the API is heavily throttled
# without them.
# SCREENSCRAPER_DEV_ID=
# SCREENSCRAPER_DEV_PASSWORD=
# SCREENSCRAPER_USER=
# SCREENSCRAPER_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Throughput
#
# Two different things: the in-process pools (work the Next server does itself)
# and WORKER_CONCURRENCY (jobs the out-of-process `pnpm worker` picks up).
# ─────────────────────────────────────────────────────────────────────────────

# WORKER_CONCURRENCY=6                   # default: 6, automatically capped to 3 when
#                                        # FLARESOLVERR_URL is set (one serial browser)
# WORKER_CONCURRENCY_FORCE=1             # bypass that cap — only with a Flare cluster
# WORKER_KINDS=metadata,catalog          # default: all kinds; restrict a dedicated worker
# WORKER_ID=                             # default: random; set it for readable logs
# WORKER_POLL_MS=1000                    # default: 1000
# WORKER_STALE_RECOVER_MS=900000         # default: 900000 (15 min) — reclaim stuck jobs

# BACKGROUND_IO_CONCURRENCY=4            # default: 4 — in-process I/O pool
# BACKGROUND_CPU_CONCURRENCY=2           # default: 2 — sharp image localization
# BACKGROUND_WORK_CONCURRENCY=           # legacy name, still honoured as the I/O default

# PRISMA_PG_POOL_MAX=10                  # default: 10 — keep (workers × pool) under the
#                                        # Postgres max_connections (100)

# ─────────────────────────────────────────────────────────────────────────────
# Timeouts
# ─────────────────────────────────────────────────────────────────────────────

# METADATA_PROVIDER_TIMEOUT_MS=          # default: 20000 background / 35000 interactive
# BARCODE_LOOKUP_TASK_DEADLINE_MS=8000   # default: 8000 — soft cap per barcode lookup task

# ─────────────────────────────────────────────────────────────────────────────
# Local corpora (offline indexes)
#
# Each index is built on demand and cached on disk. `*_ALLOW_DOWNLOAD` gates the
# only steps that reach the network for a bulk file — off by default.
# ─────────────────────────────────────────────────────────────────────────────

# LaunchBox — game metadata + box art
# LAUNCHBOX_ALLOW_DOWNLOAD=0             # default: off; 1/true/yes to allow the ZIP download
# LAUNCHBOX_METADATA_ZIP_URL=
# LAUNCHBOX_METADATA_XML=                # path to an already-extracted Metadata.xml
# LAUNCHBOX_INDEX_PATH=
# LAUNCHBOX_CACHE_DIR=

# No-Intro — ROM dump checksums
# NOINTRO_ALLOW_DOWNLOAD=0               # default: off
# NOINTRO_DAT_PACK_URL=
# NOINTRO_DAT_PACK=                      # path to a local DAT pack archive
# NOINTRO_DAT_PATH=
# NOINTRO_INDEX_PATH=
# NOINTRO_CACHE_DIR=

# iCollect Everything — collector catalog
# ICOLLECT_CATALOG_SYNC=0                # default: off
# ICOLLECT_INDEX_PATH=
# ICOLLECT_CACHE_DIR=
# ICOLLECT_PAGE_SCRAPE_BATCH=0           # default: 0 (no page scraping during sync)
# ICOLLECT_PAGE_SCRAPE_CONCURRENCY=1     # default: 1
# ICOLLECT_PAGE_SCRAPE_DELAY_MS=0        # default: 0

# Title IDF corpus
# TOKEN_CORPUS_INDEX_PATH=
# TOKEN_CORPUS_CACHE_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# Development / tests only
# ─────────────────────────────────────────────────────────────────────────────

# RECORD=1                               # record network fixtures instead of replaying
# RECORD_CASE_ID=                        # record a single barcode case
# BARCODE_RECORD_SLIM=1                  # skip known-stalling scrapes while recording
# SCREENSCRAPER_FORCE_UPDATE=1           # ignore the ScreenScraper cache
