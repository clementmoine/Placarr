{
  "name": "placarr",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev:ssl": "next dev --experimental-https",
    "dev:app": "next dev --webpack",
    "dev": "concurrently -k -n next,worker,icollect -c cyan,magenta,yellow \"pnpm dev:app\" \"pnpm worker:dev\" \"pnpm worker:icollect:dev\"",
    "dev:turbo": "concurrently -k -n next,worker,icollect -c cyan,magenta,yellow \"next dev --turbopack\" \"pnpm worker:dev\" \"pnpm worker:icollect:dev\"",
    "dev:docker": "docker compose -f compose.dev.yml up",
    "dev:docker:down": "docker compose -f compose.dev.yml down",
    "worker": "WORKER_CONCURRENCY=6 tsx scripts/backgroundWorker.ts",
    "worker:dev": "WORKER_CONCURRENCY=6 tsx watch --clear-screen=false --exclude \"**/data/**\" --exclude \"**/.next/**\" --exclude \"**/node_modules/**\" scripts/backgroundWorker.ts",
    "worker:icollect": "WORKER_KINDS=catalog WORKER_CONCURRENCY=1 tsx scripts/backgroundWorker.ts",
    "worker:icollect:dev": "WORKER_KINDS=catalog WORKER_CONCURRENCY=1 tsx watch --clear-screen=false --exclude \"**/data/**\" --exclude \"**/.next/**\" --exclude \"**/node_modules/**\" scripts/backgroundWorker.ts",
    "build": "prisma generate && NODE_OPTIONS=--max-old-space-size=16384 next build --webpack",
    "build:turbo": "prisma generate && NODE_OPTIONS=--max-old-space-size=16384 next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:record": "RECORD=1 BARCODE_RECORD_SLIM=1 vitest run src/core/identify/resolver.fresh.test.ts",
    "test:record:one": "RECORD=1 BARCODE_RECORD_SLIM=1 RECORD_CASE_ID=mario-kart-wii vitest run src/core/identify/resolver.fresh.test.ts",
    "test:record:all": "tsx scripts/record-all-barcode-fixtures.ts",
    "providers:audit:mapping": "tsx scripts/providerMappingAudit.ts",
    "title-idf:update": "tsx scripts/buildTitleIdfIndex.ts"
  },
  "dependencies": {
    "@arkntools/unity-js": "5.1.0",
    "@arkntools/unity-js-tools": "3.2.0",
    "@hookform/resolvers": "5.9.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.101.4",
    "@yudiel/react-qr-scanner": "2.6.0",
    "axios": "1.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "color": "5.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "fast-levenshtein": "^3.0.0",
    "framer-motion": "13.1.0",
    "html-entities": "^2.6.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "next-themes": "0.4.6",
    "pg": "^8.23.0",
    "prisma": "7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "romanizr": "^2.0.0",
    "sharp": "0.35.3",
    "simple-xml-to-json": "^1.2.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unityfs-js": "0.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mswjs/interceptors": "^0.42.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.5.1+sha512.k_e1dCLqcGglcjW0wW62B2LraOHcI3IxmcxzkEPqm-LEFDJ0o5nYxt76KxF2Im2cocS2NILWIAwaj7qnjB0UhQ"
}
