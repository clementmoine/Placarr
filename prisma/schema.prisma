generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  guest
  user
  admin
}

enum Condition {
  new
  used
  loose
  damaged
}

enum Type {
  games
  movies
  musics
  books
  boardgames
  hardware
  tcg
  toys
}

enum AttachmentType {
  cover
  background
  screenshot
  artwork
  image
  logo
  audio
  // Not a picture of the object: the alpha layer saying where a card's
  // holographic effect applies. Every gallery filters attachments through an
  // allow-list of display types, so this one stays out of them by construction.
  foilMask
}

/// Physical presence of a shelf copy relative to the active collection.
/// `past` = left the everyday shelf (sold, discarded, …) but always recoverable.
enum ItemPresence {
  owned
  away
  wanted
  past
}

/// Why a copy is not on the shelf. Temporary reasons map to `away`;
/// definitive reasons map to `past` (still recoverable via « Récupéré »).
enum AbsenceReason {
  loaned
  ordered
  repair
  rental
  sold
  exchanged
  gifted
  discarded
  lost
  stolen
}

model Attachment {
  id              String         @id @default(cuid())
  type            AttachmentType
  title           String?
  duration        Int?
  url             String
  metadataId      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  role            String?
  source          String?
  // Factual source context of a cover image (catalog / listing_photo /
  // user_photo). Persisted because it is derived from the provider's original
  // image URL, which is rewritten to a local /uploads path on download — so it
  // cannot be recomputed from the stored URL. Drives the provenance tier in the
  // cover ranking (see @/lib/media/coverProvenance).
  coverProvenance String?
  // Platform this cover belongs to, derived from the provider's original image URL
  // (ScreenScraper `systemeid`, hdjv `/PS3/` path segment, …) at enrichment time.
  // Persisted because localization rewrites the URL to a local /uploads path, which
  // drops the platform signal — so it cannot be recomputed at read time. Drives the
  // platform-aware cover ranking: a cover on a foreign console is dropped, an
  // unidentified one sinks, the shelf-platform one leads. See
  // @/core/enrich/media/attachmentDisplayScore.
  platformKey     String?
  // Image metrics measured once at enrichment (sharp) and persisted so the
  // read-time cover ranking can sort by resolution + exposure without
  // re-decoding files on every page render. width/height are the trimmed
  // content box when neutral margins pad the canvas (not raw file size).
  // See @/core/enrich/media/imageMetrics + attachmentDisplayScore.
  width           Int?
  height          Int?
  meanLuminance   Float?
  darkPixelRatio  Float?
  metadata        Metadata       @relation(fields: [metadataId], references: [id], onDelete: Cascade)

  @@index([metadataId])
}

model FieldEvidence {
  id              String        @id @default(cuid())
  field           String
  source          String
  value           String
  normalizedValue String?
  rawValue        Json?
  confidence      Float?
  priority        Int?
  sourceUrl       String?
  locale          String?
  region          String?
  itemId          String?
  metadataId      String?
  barcodeCacheId  Int?
  observedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  item            Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  metadata        Metadata?     @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  barcodeCache    BarcodeCache? @relation(fields: [barcodeCacheId], references: [id], onDelete: Cascade)

  @@index([field])
  @@index([source])
  @@index([itemId, field])
  @@index([metadataId, field])
  @@index([barcodeCacheId, field])
  @@index([observedAt])
}

model PriceOffer {
  id             String        @id @default(cuid())
  source         String
  productName    String?
  merchantName   String?
  condition      String?
  priceCents     Int
  currency       String        @default("EUR")
  shippingCents  Int?
  totalCents     Int?
  sourceUrl      String?
  availability   String?
  offerCount     Int?
  rawValue       Json?
  itemId         String?
  metadataId     String?
  barcodeCacheId Int?
  observedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  item           Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  metadata       Metadata?     @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  barcodeCache   BarcodeCache? @relation(fields: [barcodeCacheId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([itemId, source])
  @@index([metadataId, source])
  @@index([barcodeCacheId, source])
  @@index([condition, priceCents])
  @@index([observedAt])
}

model Shelf {
  id         String   @id @default(cuid())
  name       String
  slug       String?
  imageUrl   String?
  color      String?
  type       Type
  cardFormat String   @default("default")
  /// Optional catalogue pack scope (`data/<pack>/`) — checklist / Sync affinity
  /// without inferring solely from item printKeys.
  dataPack   String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      Item[]
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
  @@index([dataPack])
}

model Author {
  name     String     @id
  imageUrl String?
  metadata Metadata[] @relation("MetadataAuthors")
}

model Publisher {
  name     String     @id
  imageUrl String?
  metadata Metadata[] @relation("MetadataPublishers")
}

model Metadata {
  id            String          @id @default(cuid())
  title         String?
  duration      Int?
  pageCount     Int?
  tracksCount   Int?
  description   String?
  releaseDate   String?
  imageUrl      String?
  heroImageUrl  String?
  sourceType    Type
  sourceQuery   String
  lastFetched   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  aliases       String?
  facts         String?
  attachments   Attachment[]
  fieldEvidence FieldEvidence[]
  priceOffers   PriceOffer[]
  items         Item[]
  authors       Author[]        @relation("MetadataAuthors")
  publishers    Publisher[]     @relation("MetadataPublishers")
}

model Item {
  id                        String          @id @default(cuid())
  name                      String
  slug                      String?
  description               String?
  imageUrl                  String?
  barcode                   String?
  // Identity anchor for objects that never carry a barcode — a trading card is
  // identified by what is printed on it (`lorcana:9-1`). Kept separate from
  // `barcode` on purpose: a column holding something that is not a barcode
  // costs more in the long run than the extra column. See core/identify/printKey.
  printKey                  String?
  // Which expansion this copy was collected as (`s5`, `1`, `part1`). Set-scoped
  // checklists need it: Naruto reuses one printKey across series, so owning
  // NI-049 for S5 must not auto-complete S1. Null = legacy / unknown — the
  // checklist still counts the printKey in every set that lists it.
  setCode                   String?
  // Which variant of the object this copy is: a card's finish (foil, reverse),
  // eventually a game's completeness. Deliberately generic and free text —
  // every media type has variants and the vocabulary belongs to the provider,
  // not to an enum here. Distinct from `condition`, which describes the copy's
  // health rather than which thing it is. Options come from the metadata's
  // `variant-option` facts. See core/enrich/variants.
  variant                   String?
  // Which language this copy is printed in, as a lowercase code (`fr`, `ja`).
  // Part of what the copy IS, not of the print's identity: providers give one
  // key per card and several localizations under it — TCGdex answers `2011bw-1`
  // for both Snivy and Vipélierre. 898 Naruto keys and 19673 Pokémon keys carry
  // titles in more than one language, and without this column the French and
  // the Japanese copy of the same number were indistinguishable — same slug,
  // and the second one got a `-copy-N` suffix claiming it duplicated the first.
  // Null means unknown, never "the default one".
  language                  String?
  condition                 Condition
  metadataId                String?
  shelfId                   String
  userId                    String
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  backgroundImageUrl        String?
  metadataRefreshStartedAt  DateTime?
  metadataRefreshGeneration Int             @default(0)
  // Shelf presence — replaces the old loanedTo/loanedAt personal-loan note.
  // See core/collect/itemAbsence.ts.
  presence                  ItemPresence    @default(owned)
  absenceReason             AbsenceReason?
  absenceSince              DateTime?
  absenceRecipient          String?
  absenceSource             String?
  absenceCarrier            String?
  absenceTracking           String?
  absenceOrderRef           String?
  absenceOrderUrl           String?
  absenceNote               String?
  /// Sale price in integer cents (null when unset / non-sale reasons).
  absencePriceCents         Int?
  absenceExpectedAt         DateTime?
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelf                     Shelf           @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  metadata                  Metadata?       @relation(fields: [metadataId], references: [id])
  fieldEvidence             FieldEvidence[]
  priceOffers               PriceOffer[]
  presenceEvents            ItemPresenceEvent[]
  tradeLinksOut             ItemTradeLink[] @relation("TradeOut")
  tradeLinksIn              ItemTradeLink[] @relation("TradeIn")

  @@index([shelfId])
  @@index([userId])
  @@index([metadataId])
  @@index([barcode])
  @@index([printKey])
  @@index([printKey, setCode, variant, language])
  @@index([printKey, variant, language])
  @@index([slug])
  @@index([presence])
  @@index([presence, absenceReason])
  @@index([absenceRecipient])
}

/// Lifecycle trace for shelf presence (acquired → departed → returned / recovered…).
model ItemPresenceEvent {
  id           String         @id @default(cuid())
  itemId       String
  at           DateTime       @default(now())
  fromPresence ItemPresence
  toPresence   ItemPresence
  reason       AbsenceReason?
  /// acquired | departed | returned | cancelled_to_wanted | received_from_order | recovered
  kind         String
  snapshot     Json?
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, at])
  @@index([kind, at])
}

/// Bidirectional exchange edge between two shelf items (troc).
model ItemTradeLink {
  id        String   @id @default(cuid())
  itemOutId String
  itemInId  String
  note      String?
  eventId   String?
  createdAt DateTime @default(now())
  itemOut   Item     @relation("TradeOut", fields: [itemOutId], references: [id], onDelete: Cascade)
  itemIn    Item     @relation("TradeIn", fields: [itemInId], references: [id], onDelete: Cascade)

  @@unique([itemOutId, itemInId])
  @@index([itemOutId])
  @@index([itemInId])
}

model RawName {
  id             Int          @id @default(autoincrement())
  value          String
  coverUrl       String?
  barcodeCacheId Int
  barcodeCache   BarcodeCache @relation(fields: [barcodeCacheId], references: [id], onDelete: Cascade)

  @@index([barcodeCacheId])
}

model BarcodeCache {
  id                       Int             @id @default(autoincrement())
  barcode                  String          @unique
  provider                 String
  platformKey              String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  shelfType                String?
  mediaFormat              String?
  // The compile step's final, structured title decision, persisted verbatim so a
  // cache read reuses it instead of lossily re-deriving (which stripped integral
  // edition terms like "Gottlieb Pinball Classics" → "Gottlieb Pinball"). Null on
  // pre-migration rows, which fall back to re-derivation.
  cleanName                String?
  displayName              String?
  edition                  String?
  priceLastUpdated         DateTime?
  priceNew                 Int?
  priceUsed                Int?
  priceUsedCIB             Int?
  observations             Json?
  observationSchemaVersion String?
  rawNames                 RawName[]
  fieldEvidence            FieldEvidence[]
  priceOffers              PriceOffer[]
}

model UnresolvedBarcodeScan {
  id          Int      @id @default(autoincrement())
  barcode     String
  shelfType   String   @default("unknown")
  reason      String
  status      String   @default("open")
  seenCount   Int      @default(1)
  providers   String?
  rawNames    String?
  rawPayload  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([barcode, shelfType, reason])
  @@index([barcode])
  @@index([status, lastSeenAt])
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  role      UserRole @default(guest)
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
  shelves   Shelf[]
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Out-of-process work queue — claimed by `pnpm worker`, never run inside Next `after()`.
model BackgroundWorkJob {
  id         String    @id @default(cuid())
  kind       String
  status     String    @default("pending")
  itemId     String?
  userId     String?
  payload    Json
  attempts   Int       @default(0)
  lockedAt   DateTime?
  lockedBy   String?
  runAfter   DateTime  @default(now())
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([status, runAfter, createdAt])
  @@index([itemId, kind, status])
  @@index([userId, status])
}

/// Durable scrape yield shared Next ↔ worker (typed JSON, not raw HTML).
/// Keyed by registry provider id + normalized URL; TTL via expiresAt.
model ProviderEvidence {
  id         String   @id @default(cuid())
  providerId String
  url        String
  kind       String
  yieldJson  Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([providerId, url])
  @@index([expiresAt])
  @@index([providerId, kind])
}

/// Learned provider successes at catalogue scope (not per-item).
/// A price/cover/face win on one shelf item generalizes to the corpus scope.
model ProviderAffinity {
  id           String   @id @default(cuid())
  /// `type:<shelfType>` | `pack:<dataPack>` — never an item id.
  scopeKey     String
  /// price | cover | faces | identify | catalogRefresh
  capability   String
  providerId   String
  successCount Int      @default(1)
  confidence   Float    @default(0.5)
  lastAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scopeKey, capability, providerId])
  @@index([scopeKey, capability, successCount])
  @@index([providerId, capability])
}

/// Shelf item proposed for promotion into a local catalogue corpus (admin confirm).
model CorpusPromoteCandidate {
  id        String   @id @default(cuid())
  itemId    String
  /// Target pack under `data/<pack>/` when known.
  dataPack  String?
  printKey  String?
  barcode   String?
  title     String?
  /// pending | accepted | rejected
  status    String   @default("pending")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([itemId])
  @@index([printKey])
  @@index([barcode])
}
